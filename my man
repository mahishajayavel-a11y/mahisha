<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>For Asu ❤️</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    background: radial-gradient(circle at top, #4b0712, #180106 55%, #050005);
    color: white;
    font-family: Georgia, serif;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.container {
    width: 90%;
    max-width: 430px;
    text-align: center;
    padding: 35px 25px;
}

.heart {
    font-size: 65px;
    animation: heartbeat 1.5s infinite;
    margin-bottom: 15px;
}

h1 {
    font-size: 32px;
    margin: 10px 0;
}

p {
    color: #f4dede;
    line-height: 1.7;
    font-size: 17px;
}

button {
    margin-top: 25px;
    padding: 14px 28px;
    border: 1px solid white;
    border-radius: 30px;
    background: #7d0b1d;
    color: white;
    font-size: 16px;
    cursor: pointer;
    transition: 0.3s;
}

button:hover {
    background: #a80e27;
    transform: scale(1.05);
}

.page {
    display: none;
    animation: fade 1s ease;
}

.page.active {
    display: block;
}

.small {
    font-size: 14px;
    opacity: 0.7;
}

.message {
    margin-top: 25px;
    padding: 20px;
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 20px;
    background: rgba(255,255,255,0.05);
}

.floating-heart {
    position: fixed;
    bottom: -20px;
    font-size: 20px;
    animation: float 6s linear infinite;
    opacity: 0.8;
}

@keyframes heartbeat {
    0%,100% { transform: scale(1); }
    50% { transform: scale(1.15); }
}

@keyframes fade {
    from {
        opacity: 0;
        transform: translateY(15px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes float {
    from {
        transform: translateY(0);
        opacity: 0;
    }
    20% {
        opacity: 1;
    }
    to {
        transform: translateY(-110vh);
        opacity: 0;
    }
}
</style>
</head>

<body>

<div class="container">

    <!-- PAGE 1 -->
    <div class="page active" id="page1">
        <div class="heart">♡</div>

        <h1>Hey Asu...</h1>

        <p>
            I made a little something for you.
            <br>
            It's nothing huge...
            just something from me to you. 🤍
        </p>

        <button onclick="nextPage(2)">Open it ♡</button>

        <p class="small">Don't skip anything 👀</p>
    </div>


    <!-- PAGE 2 -->
    <div class="page" id="page2">

        <div class="heart">♡</div>

        <h1>Chelloww 🤍</h1>

        <p>
            Do you know what I like the most?
            <br><br>
            The little moments.
            The random conversations.
            The silly things.
            And simply having you in my life.
        </p>

        <button onclick="nextPage(3)">One more thing →</button>

    </div>


    <!-- PAGE 3 -->
    <div class="page" id="page3">

        <div class="heart">♡</div>

        <h1>A tiny reminder...</h1>

        <div class="message">

            <p>
                You don't have to do anything special
                to make me smile.
            </p>

            <p>
                Sometimes just seeing your name pop up
                is enough. 🤍
            </p>

        </div>

        <button onclick="nextPage(4)">Keep going ♡</button>

    </div>


    <!-- PAGE 4 -->
    <div class="page" id="page4">

        <div class="heart">♡</div>

        <h1>And finally...</h1>

        <p>
            Thank you for being you.
            <br><br>
            Thank you for the laughs,
            the conversations,
            the little moments,
            and all the memories we're making.
        </p>

        <p>
            I hope this tiny surprise
            made you smile. 🤍
        </p>

        <button onclick="nextPage(5)">Last one...</button>

    </div>


    <!-- PAGE 5 -->
    <div class="page" id="page5">

        <div class="heart">♡</div>

        <h1>For you, Asu ❤️</h1>

        <div class="message">

            <p>
                No fancy words.
                No big explanation.
            </p>

            <p>
                Just this:
            </p>

            <h2>Chelloww, you mean a lot to me. 🤍</h2>

            <p>
                — from your Mahisha ♡
            </p>

        </div>

    </div>

</div>


<script>

function nextPage(number) {

    document.querySelectorAll(".page").forEach(page => {
        page.classList.remove("active");
    });

    document.getElementById("page" + number).classList.add("active");
}


// Floating white hearts

function createHeart() {

    const heart = document.createElement("div");

    heart.className = "floating-heart";

    heart.innerHTML = "♡";

    heart.style.left = Math.random() * 100 + "vw";

    heart.style.animationDuration =
        (4 + Math.random() * 4) + "s";

    document.body.appendChild(heart);

    setTimeout(() => {
        heart.remove();
    }, 8000);
}

setInterval(createHeart, 700);

</script>

</body>
</html>
